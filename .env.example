# .env.example for dbtcx — copy to .env and fill in your values.
# .env is gitignored; never commit.

DBT_CLOUD_API_TOKEN=dbtu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DBT_CLOUD_ACCOUNT_ID=12345

# Bare hostname only — dbt-cloud-cli prepends https:// internally.
# Multi-tenant US:    cloud.getdbt.com
# Single-tenant US:   <prefix>.us1.dbt.com (e.g. ab123.us1.dbt.com)
# EMEA:               emea.dbt.com
# AU:                 au.dbt.com
DBT_CLOUD_HOST=cloud.getdbt.com

# Optional: when true, suppresses destructive subcommands.
DBT_CLOUD_READONLY=true
